# Server Port
PORT=5000

# Environment Mode
NODE_ENV=development

# MongoDB Connection String (Leave blank for zero-config built-in in-memory database)
MONGODB_URI=mongodb://127.0.0.1:27017/blood_donor_db

# JWT Secret & Expiry
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRE=30d

# Development Admin Credentials (Development Only)
# WARNING: Do not use default credentials in production
ADMIN_EMAIL=admin123@gmail.com
ADMIN_PASSWORD=admin123
