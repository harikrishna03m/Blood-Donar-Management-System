# Server Port
PORT=5000

# Environment Mode
NODE_ENV=development

# MongoDB Connection String (Leave blank for zero-config built-in in-memory database in development)
MONGODB_URI=mongodb://127.0.0.1:27017/blood_donor_db

# JWT Secret & Expiry
JWT_SECRET=your_secure_jwt_secret_key_here
JWT_EXPIRE=30d

# Admin Account Configuration
ADMIN_EMAIL=your_admin_email@domain.com
ADMIN_PASSWORD=your_secure_admin_password

# Development Database Seeding (Set to 'true' only to seed sample data for development)
SEED_DEV_DATA=false
