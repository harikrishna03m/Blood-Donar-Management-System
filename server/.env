# Server Port
PORT=5000

# Environment Mode
NODE_ENV=development

# MongoDB Connection String
# Leave empty or undefined to automatically use the zero-config In-Memory MongoDB Server
MONGODB_URI=

# JWT Secret & Expiry
JWT_SECRET=blood_donor_secret_key_2026_super_secure_jwt_token
JWT_EXPIRE=30d

# Default Admin Credentials for Local Development
# Note: For production, configure strong credentials via your hosting environment.
ADMIN_EMAIL=admin123@gmail.com
ADMIN_PASSWORD=admin123
