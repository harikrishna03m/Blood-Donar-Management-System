# Server Port
PORT=5000

# Environment Mode
NODE_ENV=development

# MongoDB Connection String
# Leave empty or undefined to automatically use the zero-config In-Memory MongoDB Server in development,
# or specify your MongoDB connection string (e.g., MongoDB Atlas URI)
MONGODB_URI=

# JWT Secret & Expiry
JWT_SECRET=blood_donor_secret_key_2026_super_secure_jwt_token
JWT_EXPIRE=30d

# Admin Account Configuration (Set your private admin credentials)
# ADMIN_EMAIL=
# ADMIN_PASSWORD=

# Development Database Seeding (Set to 'true' only when explicitly populating sample data for local development)
SEED_DEV_DATA=false
